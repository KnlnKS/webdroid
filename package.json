{
  "name": "webdroid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --configLoader native",
    "build:prod": "vp build --configLoader native",
    "build:renderer": "node scripts/generated.ts --pages",
    "worker:dev": "vp build --configLoader native && wrangler dev",
    "worker:check": "vp build --configLoader native && wrangler deploy --env=\"\" --dry-run",
    "generate": "node scripts/generated.ts --force",
    "typecheck": "node scripts/generated.ts && wrangler types && tsrs -p tsconfig.json && tsrs -p tsconfig.worker.json",
    "test": "vp test run --configLoader native",
    "ts": "scripts/node",
    "inspect": "scripts/node scripts/inspect.ts",
    "smoke": "scripts/node scripts/wasm/run.ts sweep",
    "audit": "scripts/node scripts/audit.ts",
    "opscan": "scripts/node scripts/opscan.ts",
    "corpus": "scripts/node scripts/corpus.ts",
    "dis": "scripts/node scripts/dis.ts",
    "layout": "scripts/node scripts/layout.ts",
    "findstr": "scripts/node scripts/findstr.ts",
    "dbg": "scripts/node scripts/dbg.ts",
    "gen-framework": "scripts/node scripts/gen-framework.ts",
    "fwscan": "scripts/node scripts/fwscan.ts",
    "fwtest": "scripts/node scripts/wasm/run.ts fwtest",
    "desccheck": "scripts/node scripts/desccheck.ts",
    "bypass": "scripts/node scripts/bypass.ts",
    "fuzz": "scripts/node scripts/fuzz.ts",
    "e2e:setup": "bash tests/e2e/setup-avd.sh",
    "e2e:boot": "bash tests/e2e/boot-emulator.sh",
    "e2e": "scripts/node tests/e2e/run.ts",
    "textcmp": "scripts/node scripts/textcmp.ts",
    "lat": "scripts/node scripts/lat/run.ts",
    "conform": "scripts/node scripts/wasm/run.ts conform",
    "wasm": "scripts/node scripts/wasm/run.ts",
    "aot": "scripts/node scripts/wasm/run.ts aot"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "canvaskit-wasm": "0.38.0",
    "eslint-scope": "^9.1.2",
    "fflate": "^0.8.2",
    "harfbuzzjs": "1.6.2",
    "libheif-js": "1.23.2",
    "mp4box": "2.3.0",
    "pako": "^2.1.0",
    "sql.js": "workspace:*",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/estree": "^1.0.9",
    "@types/node": "24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "binaryen": "^132.0.0",
    "html-rewriter-wasm": "0.4.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.9.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.137.0",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@11.0.8"
}
