{
  "name": "webdroid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --configLoader native",
    "build:prod": "vp build --configLoader native",
    "worker:dev": "vp build --configLoader native && wrangler dev",
    "worker:check": "vp build --configLoader native && wrangler deploy --env=\"\" --dry-run",
    "generate": "node scripts/generated.ts --force",
    "typecheck": "node scripts/generated.ts && wrangler types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vp test run --configLoader native",
    "ts": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts",
    "inspect": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/inspect.ts",
    "smoke": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/wasm/run.ts sweep",
    "audit": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/audit.ts",
    "opscan": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/opscan.ts",
    "corpus": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/corpus.ts",
    "dis": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/dis.ts",
    "layout": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/layout.ts",
    "findstr": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/findstr.ts",
    "dbg": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/dbg.ts",
    "gen-framework": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/gen-framework.ts",
    "fwscan": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/fwscan.ts",
    "fwtest": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/wasm/run.ts fwtest",
    "desccheck": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/desccheck.ts",
    "bypass": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/bypass.ts",
    "fuzz": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/fuzz.ts",
    "e2e:setup": "bash tests/e2e/setup-avd.sh",
    "e2e:boot": "bash tests/e2e/boot-emulator.sh",
    "e2e": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts tests/e2e/run.ts",
    "textcmp": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/textcmp.ts",
    "lat": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/lat/run.ts",
    "jbench": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/wasm/run.ts jbench",
    "conform": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/wasm/run.ts conform",
    "wasm": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/wasm/run.ts",
    "aot": "node --experimental-wasm-jspi --expose-gc --import ./scripts/preload.ts scripts/wasm/run.ts aot"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "canvaskit-wasm": "0.38.0",
    "eslint-scope": "^9.1.2",
    "fflate": "^0.8.2",
    "harfbuzzjs": "1.6.2",
    "libheif-js": "1.23.2",
    "mp4box": "2.3.0",
    "node-forge": "^1.4.0",
    "pako": "^2.1.0",
    "sql.js": "workspace:*",
    "tough-cookie": "^6.0.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/estree": "^1.0.9",
    "@types/node": "26.6.5",
    "@types/node-forge": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "html-rewriter-wasm": "0.4.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.137.0",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@11.0.8"
}
