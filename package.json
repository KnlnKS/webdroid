{
  "name": "webdroid",
  "private": true,
  "type": "module",
  "workspaces": ["vendor/sql.js"],
  "scripts": {
    "dev": "bun run server.ts",
    "build:prod": "bun scripts/build-prod.ts",
    "worker:dev": "bun run build:prod && wrangler dev",
    "worker:check": "bun run build:prod && wrangler deploy --env=\"\" --dry-run",
    "typecheck": "bun scripts/build-core.ts && wrangler types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test --parallel src tests",
    "inspect": "bun scripts/inspect.ts",
    "smoke": "bun scripts/smoke.ts",
    "audit": "bun scripts/audit.ts",
    "opscan": "bun scripts/opscan.ts",
    "corpus": "bun scripts/corpus.ts",
    "dis": "bun scripts/dis.ts",
    "jsrc": "bun scripts/jsrc.ts",
    "layout": "bun scripts/layout.ts",
    "findstr": "bun scripts/findstr.ts",
    "trace": "bun scripts/trace.ts",
    "dbg": "bun scripts/dbg.ts",
    "gen-framework": "bun scripts/gen-framework.ts",
    "fwscan": "bun scripts/fwscan.ts",
    "fwtest": "bun scripts/fwtest.ts",
    "desccheck": "bun scripts/desccheck.ts",
    "bypass": "bun scripts/bypass.ts",
    "fuzz": "bun scripts/fuzz.ts",
    "e2e:setup": "bash tests/e2e/setup-avd.sh",
    "e2e:boot": "bash tests/e2e/boot-emulator.sh",
    "e2e": "bun tests/e2e/run.ts",
    "textcmp": "bun scripts/textcmp.ts",
    "lat": "bun scripts/lat/run.ts",
    "relaunch": "bun scripts/relaunch.ts",
    "jbench": "bun scripts/jbench/run.ts",
    "conform": "bun scripts/conform/run.ts",
    "build:core": "bun scripts/build-core.ts"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "canvaskit-wasm": "0.38.0",
    "eslint-scope": "^9.1.2",
    "fflate": "^0.8.2",
    "harfbuzzjs": "1.6.2",
    "libheif-js": "1.23.2",
    "mp4box": "2.3.0",
    "node-forge": "^1.4.0",
    "pako": "^2.1.0",
    "sql.js": "workspace:*",
    "tough-cookie": "^6.0.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/bun": "^1.4.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.2",
    "@types/node-forge": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/sql.js": "^1.4.11",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "wrangler": "^4.137.0"
  }
}
