{
  // the shell page, on Pages; the backend Worker is worker/wrangler.jsonc
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webdroid",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-23",
  "services": [{ "binding": "BACKEND", "service": "webdroid-backend" }],
  "env": {
    // a branch's Worker preview, which a static binding cannot select, takes the place of the binding's production Worker
    "preview": {
      "services": [{ "binding": "BACKEND", "service": "webdroid-backend" }],
      "vars": { "BACKEND_ORIGIN": "https://*-webdroid-backend.kunalan-k-subagaran.workers.dev" }
    }
  }
}
