{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webdroid",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/proxy*", "/tcp*", "/dns*", "/webview*", "/vendor/aosp/*", "/vendor/android-cacerts.pem", "/vendor/microg/*.gz"]
  },
  "vars": { "WEBVIEW_ORIGIN": "https://webdroid-renderer.pages.dev", "PREVIEW_BRANCH": "" },
  "previews": {
    "vars": { "WEBVIEW_ORIGIN": "https://*.webdroid-renderer.pages.dev", "PREVIEW_BRANCH": "" },
    "durable_objects": {
      "bindings": [{ "name": "WEB_BRIDGES", "class_name": "WebBridgeSession" }]
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "WEB_BRIDGES", "class_name": "WebBridgeSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebBridgeSession"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
