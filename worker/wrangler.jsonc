{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // the backend (wrangler -c worker/wrangler.jsonc); the shell page deploys to Pages (../wrangler.jsonc) and forwards its routes here
  "name": "webdroid-backend",
  "main": "index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // this Worker is also the WebView renderer's origin, a site apart from the app's
  "vars": { "APP_ORIGIN": "https://webdroid.pages.dev", "WEBVIEW_ORIGIN": "https://webdroid-backend.kunalan-k-subagaran.workers.dev", "PREVIEW_ALIAS": "" },
  "previews": {
    "vars": { "APP_ORIGIN": "https://*.webdroid.pages.dev", "WEBVIEW_ORIGIN": "https://*-webdroid-backend.kunalan-k-subagaran.workers.dev", "PREVIEW_ALIAS": "" },
    "durable_objects": {
      "bindings": [{ "name": "WEB_BRIDGES", "class_name": "WebBridgeSession" }]
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "WEB_BRIDGES", "class_name": "WebBridgeSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebBridgeSession"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
