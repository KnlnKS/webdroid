// One G1 measurement in one fresh engine: a Bench workload as Wasm (lazy linking over the AOSP boot dex) or on the production JS tier,
// timed per call. Bundled by g1.ts for node (argv[2] is the JSON config) and for a page (globalThis.g1run).
import { loadDexes, program, world } from "./build";
import { jsTier, natives } from "./oracle";
import { PLATFORM_JARS } from "../../../src/jvm/provenance";

export interface G1Config { mode: "wasm" | "js"; cls: string; workload: string; reps: number; dex: string; root: string }
export interface G1Result { workload: string; mode: string; result: string; times: number[]; compileMs?: number; units?: number; error?: string }

export async function g1run(cfg: G1Config): Promise<G1Result> {
  const out: G1Result = { workload: cfg.workload, mode: cfg.mode, result: "", times: [] };
  const js = await jsTier(loadDexes(cfg.dex));
  console.warn = () => {};
  if (cfg.mode === "wasm" && (globalThis as any).process?.env.G1_TWICE) {
    for (let k = 0; k < 4; k++) { const w2 = world(program([cfg.dex, ...PLATFORM_JARS.map((j) => `${cfg.root}/vendor/aosp/${j}`)]), { natives }); const t = performance.now(); w2.entry(cfg.cls, `w_${cfg.workload}`, "()I")(); console.error(`world ${k}: first call ${(performance.now() - t).toFixed(1)} ms, compile ${w2.stats.compileMs.toFixed(1)} ms for ${w2.stats.methods} methods in ${w2.stats.units} units, module ${w2.stats.moduleMs.toFixed(1)} instance ${w2.stats.instantiateMs.toFixed(1)} classes ${w2.stats.classes} (${w2.stats.classMs.toFixed(1)} ms)`); }
  }
  const w = cfg.mode === "wasm" ? world(program([cfg.dex, ...PLATFORM_JARS.map((j) => `${cfg.root}/vendor/aosp/${j}`)]), { natives }) : null;
  let hit = 0;
  if (w) w.onGap = () => hit++;
  const name = `w_${cfg.workload}`;
  const t0 = performance.now();
  const call = w ? w.entry(cfg.cls, name, "()I") : () => js(cfg.cls, name, "()I", []);
  try {
    // the first call includes linking and compiling everything the workload reaches
    out.result = String(await call());
    out.times.push(performance.now() - t0);
    for (let i = 0; i < cfg.reps; i++) { const t = performance.now(); await call(); out.times.push(performance.now() - t); }
  } catch (e) { out.error = hit ? `gap ${w!.gapList[0]}` : String(e).slice(0, 200); }
  if (w) { out.compileMs = w.stats.compileMs; out.units = w.stats.units; }
  return out;
}
(globalThis as { g1run?: typeof g1run }).g1run = g1run;
const arg = (globalThis as { process?: { argv: string[] } }).process?.argv[2];
if (arg && !(globalThis as { document?: unknown }).document) {
  const keep = setInterval(() => {}, 1 << 30); // the JS tier's yield channel is unref'd
  console.log("G1" + JSON.stringify(await g1run(JSON.parse(arg))));
  clearInterval(keep);
}
